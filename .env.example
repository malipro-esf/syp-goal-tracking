# Copy this file to .env before starting PostgreSQL with Docker Compose.
POSTGRES_DB=syp
POSTGRES_USER=syp
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432

# Backend settings use the SYP_ prefix.
SYP_ENVIRONMENT=development
SYP_DATABASE_URL=postgresql+psycopg://syp:local-development-only@localhost:5432/syp

