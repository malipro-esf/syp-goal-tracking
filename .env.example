# Copy this file to .env before starting PostgreSQL with Docker Compose.
POSTGRES_DB=syp
POSTGRES_USER=syp
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=55432
POSTGRES_TEST_PORT=55433

# Backend settings use the SYP_ prefix.
SYP_ENVIRONMENT=development
SYP_DATABASE_URL=postgresql+psycopg://syp:local-development-only@localhost:55432/syp
SYP_TEST_DATABASE_URL=postgresql+psycopg://syp:local-development-only@localhost:55433/syp_test
SYP_AUTH_SECRET_KEY=replace-this-with-at-least-32-random-characters
SYP_LOG_LEVEL=INFO
SYP_AUTOMATIC_PLAN_COMPLETION_ENABLED=true
SYP_AUTOMATIC_PLAN_COMPLETION_INTERVAL_SECONDS=300
# Comma-separated accounts that receive the administrator role after signing in.
SYP_ADMIN_EMAILS=
SYP_ADMIN_STALE_INVITATION_DAYS=7

# Optional Milestone 10 AI coach. Core plans and progress work without these.
SYP_AI_COACH_ENABLED=false
SYP_OPENAI_API_KEY=
SYP_AI_COACH_MODEL=gpt-5-mini
SYP_AI_COACH_DAILY_RUN_LIMIT=20
